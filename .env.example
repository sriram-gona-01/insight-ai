# Copy to .env. Every setting the code reads is listed here.

# Where decks, rendered pages, and runs are stored (gitignored).
DATA_DIR=data

# Postgres. The compose database listens on DB_PORT on localhost only.
DB_PORT=5433
POSTGRES_PASSWORD=insight
DATABASE_URL=postgresql://insight:insight@localhost:5433/insight

# Text embeddings. Changing the model or dim requires a fresh database.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIM=384
# auto picks MPS when available, otherwise CPU.
EMBEDDING_DEVICE=auto
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "

# Ingestion.
RENDER_DPI=150
CHUNK_MAX_TOKENS=480
# Start each chunk's embedded text with its slide title.
CHUNK_TITLE_PREFIX=true
MAX_FILE_MB=200
# An unfinished ingest older than this can be claimed again.
INGEST_STALE_MINUTES=30

# LibreOffice, used to render PPTX files.
SOFFICE_PATH=soffice
SOFFICE_TIMEOUT_SECONDS=180

# Retrieval and context.
RETRIEVAL_OVERFETCH=5
DEFAULT_TOP_K=3
CONTEXT_IMAGE_MAX_SIDE=1024

# LLM: ollama, or openai_compat for a vLLM server.
LLM_BACKEND=ollama
LLM_MODEL=qwen3-vl:4b
# Used by commands run on the host. Containers use COMPOSE_OLLAMA_URL.
OLLAMA_URL=http://localhost:11434
COMPOSE_OLLAMA_URL=http://host.docker.internal:11434
# For openai_compat, include the version prefix, for example http://host:8000/v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_MAX_TOKENS=512
# Ollama context window. Each slide image takes about 1,000 tokens at the default size.
LLM_CONTEXT_TOKENS=16384
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2

# Ports on localhost for the compose services.
API_PORT=8000
UI_PORT=8501
API_URL=http://localhost:8000
