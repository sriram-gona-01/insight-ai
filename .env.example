# Copy to .env. Every setting the code reads is listed here.

# Where decks, rendered pages, and runs are stored (gitignored).
DATA_DIR=data

# Postgres. The compose database listens on DB_PORT on localhost only.
DB_PORT=5433
POSTGRES_PASSWORD=insight
DATABASE_URL=postgresql://insight:insight@localhost:5433/insight

# Text embeddings. Changing the model or dim requires a fresh database.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
EMBEDDING_DIM=384
# auto picks MPS when available, otherwise CPU.
EMBEDDING_DEVICE=auto

# Ingestion.
RENDER_DPI=150
CHUNK_MAX_TOKENS=480
# Start each chunk's embedded text with its slide title.
CHUNK_TITLE_PREFIX=true
MAX_FILE_MB=200
# An unfinished ingest older than this can be claimed again.
INGEST_STALE_MINUTES=30

# LibreOffice, used to render PPTX files.
SOFFICE_PATH=soffice
SOFFICE_TIMEOUT_SECONDS=180
